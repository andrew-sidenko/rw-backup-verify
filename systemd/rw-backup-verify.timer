[Unit]
Description=rw-backup-verify schedule tick (every minute)
# Тик частый специально: он лишь смотрит, наступило ли глобальное расписание.
# Реальный прогон защищён глобальным локом (locks/global.lock), поэтому
# параллельно с идущим run ничего не стартует.

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=15s
Persistent=true
Unit=rw-backup-verify.service

[Install]
WantedBy=timers.target
